{
  "name": "DataCraft",
  "description": "A developer utility tool for quickly encoding, decoding, formatting, and converting data.",
  "version": "1.4",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_title": "DataCraft"
  },
  "permissions": ["clipboardRead", "storage", "activeTab", "clipboardWrite"],
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
